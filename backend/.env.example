# ============================================
# Supabase Configuration
# ============================================
# Copy from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================
# Store Configuration
# ============================================
STORE_URL=https://demo.inelabteamdev.com

# ============================================
# Server Configuration
# ============================================
PORT=5000
NODE_ENV=development

# ============================================
# Security Secret for Cron Triggers
# ============================================
CRON_SECRET=super-secret-cron-token-32-chars-long

# ============================================
# Local DB Fallback (Used if Supabase credentials are not provided)
# ============================================
USE_LOCAL_DB_FALLBACK=true
LOCAL_DB_PATH=./price_tracker.db
